# ===========================================
# ClaudeGlasses Twilio Webhook Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Twilio Credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Anthropic API Key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenClaw Integration (optional - leave empty to use direct Claude API)
OPENCLAW_WEBHOOK_URL=
OPENCLAW_API_KEY=

# ElevenLabs TTS (optional - for better voice quality)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Server Configuration
PORT=3456
NODE_ENV=development

# Security
WEBHOOK_SECRET=generate_a_random_string_here
ALLOWED_CALLER_IDS=+1234567890,+0987654321

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
